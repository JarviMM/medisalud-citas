# ---------------------------------------------------------------------------
# Variables del despliegue.
#
# TODAS SON OPCIONALES: el compose trae un valor por defecto para cada una y
# arranca sin definir ninguna. Este fichero documenta qué se puede ajustar y
# cuándo tiene sentido hacerlo.
#
# En Dokploy no hace falta copiar este fichero: se pegan los pares que se
# quieran cambiar en la pestaña "Environment" de la aplicación. Ojo, ahí solo
# funcionan las variables que el compose consume con ${...}; una cualquiera
# puesta en el panel no llega al contenedor por sí sola.
# ---------------------------------------------------------------------------

# Dominio que atiende Traefik. Cambiarlo aquí evita tener que editar el compose
# y hacer commit solo para mover el despliegue de dominio.
# DOMINIO=medisalud.cuantio.net

# Zona horaria del contenedor. Importa de verdad: el horario de atención de la
# RN-01 está en hora local de la clínica. En UTC, la consulta abriría a las
# 03:00 hora de Colombia y rechazaría todas las citas de la tarde.
# TZ=America/Bogota

# Credenciales de H2. La base va en modo embebido (sin servidor TCP y con la
# consola apagada), así que solo se llega a ella desde dentro del contenedor:
# cambiarlas no añade una barrera real, pero tampoco cuesta nada.
# DB_USERNAME=sa
# DB_PASSWORD=

# Dónde vive la base. Por defecto en fichero sobre el volumen, para que los
# datos sobrevivan a los redespliegues. Para una demo que se reinicie limpia en
# cada despliegue:
#   DB_URL=jdbc:h2:mem:medisalud;DB_CLOSE_DELAY=-1
#   DDL_AUTO=create-drop
# DB_URL=jdbc:h2:file:/datos/medisalud
# DDL_AUTO=update

# Nivel de log de la aplicación. DEBUG para diagnosticar sin tocar la imagen.
# LOG_LEVEL=INFO

# Swagger UI y /v3/api-docs. Se dejan accesibles porque la documentación viva
# es parte del entregable; en un entorno público de verdad se apagarían.
# SWAGGER_HABILITADO=true

# Techo de memoria del contenedor. La JVM se dimensiona sola a partir de él
# gracias a MaxRAMPercentage, así que subirlo o bajarlo no requiere tocar nada
# más.
# MEMORIA_LIMITE=768M

# Ajustes de la JVM. Sustituye al valor por defecto por completo, así que si lo
# defines acuérdate de conservar MaxRAMPercentage.
# JAVA_OPTS=-XX:MaxRAMPercentage=75.0
